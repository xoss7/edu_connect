rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.reputationScore == 0;

      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.reputationScore == resource.data.reputationScore;

      allow delete: if false;
    }

    match /posts/{postId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.auteurId == request.auth.uid;

      // Only the likedBy field may ever change post-creation, and only by
      // exactly adding or removing the requester's own uid — a client
      // can't rewrite another user's post content or forge someone else's
      // like/unlike.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
        && (
          (request.resource.data.likedBy.hasAll(resource.data.likedBy)
            && request.resource.data.likedBy.removeAll(resource.data.likedBy) == [request.auth.uid])
          || (resource.data.likedBy.hasAll(request.resource.data.likedBy)
            && resource.data.likedBy.removeAll(request.resource.data.likedBy) == [request.auth.uid])
        );

      allow delete: if false;

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.auteurId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /resources/{resourceId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.uploaderId == request.auth.uid
        && request.resource.data.downloads == 0;

      // Only the downloads counter may ever change post-creation, and only
      // by exactly +1 per write — mirrors the posts/likedBy precise-diff
      // rule, but for a simple counter instead of a set of uids.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloads'])
        && request.resource.data.downloads == resource.data.downloads + 1;

      allow delete: if false;
    }

    match /quizzes/{quizId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.createurId == request.auth.uid;

      allow update, delete: if false;
    }

    match /quiz_attempts/{attemptId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;

      allow update, delete: if false;
    }

    // Other collections (projects, matches, conversations, ...) aren't
    // built yet.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
